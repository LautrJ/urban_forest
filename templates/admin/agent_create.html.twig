{% extends 'base.html.twig' %}

{% block title %}Créer un agent{% endblock %}

{% block body %}
    <div class="container">
        <div class="form-container">
            <div class="form-header">
                <h1>➕ Créer un compte agent</h1>
                <p>Créez un nouveau compte pour un agent municipal</p>
            </div>

            {{ form_start(form) }}
            <div class="form-group">
                {{ form_label(form.name) }}
                {{ form_widget(form.name) }}
                {{ form_errors(form.name) }}
            </div>

            <div class="form-group">
                {{ form_label(form.email) }}
                {{ form_widget(form.email) }}
                {{ form_errors(form.email) }}
                <small class="help-text">L'agent utilisera cet email pour se connecter</small>
            </div>

            <div class="form-group">
                {{ form_label(form.plainPassword.first) }}
                {{ form_widget(form.plainPassword.first) }}
                {{ form_errors(form.plainPassword.first) }}
                <small class="help-text">Minimum 6 caractères</small>
            </div>

            <div class="form-group">
                {{ form_label(form.plainPassword.second) }}
                {{ form_widget(form.plainPassword.second) }}
                {{ form_errors(form.plainPassword.second) }}
            </div>

            <div style="display: flex; gap: 1rem; margin-top: 2rem;">
                <button type="submit" class="btn-submit">
                    ✅ Créer le compte agent
                </button>
                <a href="{{ path('app_admin_agents_list') }}" class="btn btn-secondary" style="line-height: 3; text-align: center; flex: 1;">
                    Annuler
                </a>
            </div>
            {{ form_end(form) }}
        </div>

        <div style="margin-top: 2rem; text-align: center;">
            <a href="{{ path('app_admin_agents_list') }}" class="back-link">← Retour à la liste des agents</a>
        </div>
    </div>
{% endblock %}